# ==========================================
# SUPABASE CONFIGURATION (MANDATORY FOR PRODUCTION)
# ==========================================
# 1. Sign up / Log in to https://supabase.com
# 2. Create a new project (e.g., "iphone-marketplace")
# 3. Go to Project Settings -> API
# 4. Copy Project URL and Anon Public Key below:

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ==========================================
# ADMIN & STAFF CONFIGURATION
# ==========================================
# Comma-separated list of emails that have Staff / Owner access
# to reply to customer chats and manage iPhone inventory.
VITE_ADMIN_EMAILS=dcjayshop@gmail.com

# ==========================================
# SOCIAL LOGIN REDIRECT URL
# ==========================================
# For local development: http://localhost:3000
# For Netlify / Hostinger production: https://your-custom-domain.com
VITE_SITE_URL=http://localhost:3000
